// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  profile      UserProfile?
  mealLogs     MealLog[]
  sleepLogs    SleepLog[]
  waterLogs    WaterLog[]
  activityLogs ActivityLog[]
  medicines    Medicine[]
  medicineLogs MedicineLog[]
  records      HealthRecord[]
  labValues    LabValue[]

  updatedAt DateTime @updatedAt
}

model UserProfile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Physical Info
  heightCm Float?
  weightKg Float?
  age      Int?
  gender   Gender?

  // Health Info
  conditions String[] @default([])
  allergies  String[] @default([])

  // Goals
  targetCalories Int?   @default(2000)
  targetProteinG Int?   @default(50)
  targetSleepHrs Float? @default(8)
  targetWaterMl  Int?   @default(2000)

  activityLevel ActivityLevel?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MealLog {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  date     DateTime
  mealType String // 'breakfast', 'lunch', 'dinner', 'snack'
  foodName String
  calories Float
  proteinG Float
  fatG     Float
  carbsG   Float
  fiberG   Float?

  imageUrl String? // Cloudinary secure URL

  // AI confidence level
  confidence String? // "low", "medium", "high"

  source    String // 'manual' or 'ai_scan'
   notes      String? 
   
  createdAt DateTime @default(now())
}

model SleepLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  date          DateTime
  bedtime       DateTime
  wakeTime      DateTime
  hours         Float
  qualityRating Int?
}

model WaterLog {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  date     DateTime
  amountMl Int
  loggedAt DateTime @default(now())
}

model ActivityLog {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  date           DateTime
  type           String
  durationMins   Int
  caloriesBurned Float?
  notes          String?
}

enum MedicineStatus {
  pending
  taken
  missed
}

model Medicine {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  dose      String
  frequency String
  times     String[]

  startDate DateTime
  endDate   DateTime?

  notes String?

  logs MedicineLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model MedicineLog {
  id         String   @id @default(uuid())
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  takenAt     DateTime?

  status MedicineStatus @default(pending)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([medicineId, scheduledAt])
  @@index([userId, status])
}

model HealthRecord {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String // Name of the document
  type     String // 'blood_report' | 'prescription' | 'scan' | 'other'
  fileUrl  String // URL to the file in cloud storage
  fileName String? // Original filename
  mimeType String? // File MIME type

  notes String?

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relation to extracted lab values
  labValues LabValue[]

  @@index([userId, uploadedAt])
}

model LabValue {
  id       String       @id @default(uuid())
  recordId String
  record   HealthRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parameter      String // Test name (e.g., 'hemoglobin', 'vitamin_d', 'glucose', 'cholesterol')
  value          Float // Measured value
  unit           String // Unit of measurement (e.g., 'g/dL', 'ng/mL')
  referenceRange String? // Reference range (e.g., '12-16')

  testDate DateTime // When the test was done

  isAbnormal Boolean @default(false) // Flag if outside normal range

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, parameter])
  @@index([recordId])
  @@index([testDate])
}
